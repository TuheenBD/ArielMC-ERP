# ==============================================================================
# ArielMC ERP - Environment Configuration & SMTP Credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hostinger Business Mail SMTP Settings
# (Used for info@arielmc.com / tuheen@arielmc.com)
# ------------------------------------------------------------------------------
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=info@arielmc.com
HOSTINGER_SMTP_PASS=your_hostinger_email_password_here

# ------------------------------------------------------------------------------
# 2. Google Workspace / Gmail SMTP Settings
# (Used for TuheenBD@gmail.com / ArielMC.BD@gmail.com)
# Generate a Google App Password at:
# https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USER=TuheenBD@gmail.com
GMAIL_SMTP_PASS=your_16_digit_google_app_password_here

# ------------------------------------------------------------------------------
# 3. Supabase PostgreSQL Persistence (Live Data Layer)
# Used for Products, Factories, SDOs, Sales Orders, Leads, Warehouses, Inventory, PnL
# Get your project URL and Anon key from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_optional_here

